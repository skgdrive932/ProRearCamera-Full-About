<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Grid Overlay -->
    <TableLayout
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TableRow android:layout_weight="1">
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
        </TableRow>
        <TableRow android:layout_weight="1">
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
        </TableRow>
        <TableRow android:layout_weight="1">
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
            <View android:layout_weight="1" android:background="#22FFFFFF" android:layout_margin="0.5dp"/>
        </TableRow>
    </TableLayout>

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#40000000"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="⚡ OFF"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGrid"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="GRID"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAspectRatio"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="4:3"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/aboutButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="ⓘ ABOUT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pro Sliders Box -->
    <LinearLayout
        android:id="@+id/proSlidersCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/modeSelectionBar">

        <!-- EV Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="EV"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/evSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="10"
                android:progressTint="#FFD700"
                android:thumbTint="#FFD700" />
        </LinearLayout>

        <!-- Zoom Slider & Percentage Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtZoomLevel"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/zoomSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Camera Modes Switcher Bar -->
    <LinearLayout
        android:id="@+id/modeSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlPanel">

        <TextView
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="PHOTO"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modePortrait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="PORTRAIT"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeMacro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="MACRO"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modePro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="PRO"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Control Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#FF000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Circular Gallery Thumbnail Preview -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPreview"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:background="#222222"
            android:contentDescription="Gallery Preview"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp" />

        <!-- Double Ring Shutter Button -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="Capture"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
